generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductLead {
  copies                 GeneratedCopy[]
  whatsappDispatches     WhatsAppDispatch[]
  coupons                Coupon[]
  commercialPipelineRuns CommercialPipelineRun[]
  id                     String                  @id @default(cuid())
  source                 ShopeeOfferSource       @default(MOCK)
  providerProductId      String
  nome                   String
  categoria              String
  preco                  Decimal                 @db.Decimal(14, 4)
  precoMin               Decimal?                @db.Decimal(14, 4)
  precoMax               Decimal?                @db.Decimal(14, 4)
  desconto               Float
  nota                   Float
  vendidos               Int
  comissao               Float
  commissionAmount       Decimal?                @db.Decimal(14, 4)
  sellerCommissionRate   Float?
  shopeeCommissionRate   Float?
  loja                   String
  shopId                 String?
  categoryIds            String[]                @default([])
  urlImagem              String
  productLink            String?                 @map("url")
  affiliateLink          String?
  offerStartsAt          DateTime?
  offerEndsAt            DateTime?
  fetchedAt              DateTime                @default(now())
  lastSeenAt             DateTime                @default(now())
  unavailableAt          DateTime?
  title                  String
  score                  Int?
  scoreUpdatedAt         DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([source, providerProductId])
  @@index([source, lastSeenAt])
  @@index([offerEndsAt, unavailableAt])
}

model GeneratedCopy {
  id                 String             @id @default(cuid())
  productId          String
  product            ProductLead        @relation(fields: [productId], references: [id], onDelete: Cascade)
  whatsappDispatches WhatsAppDispatch[]
  titulo             String
  mensagem           String
  cta                String
  hashtags           String
  createdAt          DateTime           @default(now())

  @@index([productId])
}

model WhatsAppDestination {
  id                     String                  @id @default(cuid())
  name                   String
  destination            String
  type                   WhatsAppDestinationType @default(INDIVIDUAL)
  active                 Boolean                 @default(true)
  available              Boolean                 @default(true)
  fingerprint            String?
  sourceInstanceName     String?
  memberCount            Int?
  ownerIsParticipant     Boolean?
  discoveredAt           DateTime?
  lastSyncedAt           DateTime?
  dispatches             WhatsAppDispatch[]
  commercialPipelineRuns CommercialPipelineRun[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([destination, sourceInstanceName])
  @@index([type, active, available])
}

model WhatsAppDispatch {
  id                    String                    @id @default(cuid())
  productId             String
  product               ProductLead               @relation(fields: [productId], references: [id], onDelete: Cascade)
  generatedCopyId       String
  generatedCopy         GeneratedCopy             @relation(fields: [generatedCopyId], references: [id], onDelete: Cascade)
  destinationId         String
  destination           WhatsAppDestination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  externalMessageId     String?
  status                WhatsAppDispatchStatus    @default(PENDING)
  attemptCount          Int                       @default(0)
  errorMessage          String?
  sentAt                DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  commercialPipelineRun CommercialPipelineRun?
  commercialOutbox      CommercialDispatchOutbox?

  @@unique([generatedCopyId, destinationId])
  @@index([productId])
  @@index([destinationId])
  @@index([status])
  @@index([status, sentAt])
  @@index([destinationId, status, sentAt])
}

model Coupon {
  id              String             @id @default(cuid())
  source          CouponSource
  code            String
  description     String
  discountType    CouponDiscountType
  discountValue   Decimal            @db.Decimal(14, 4)
  minPurchase     Decimal?           @db.Decimal(14, 4)
  maxDiscount     Decimal?           @db.Decimal(14, 4)
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean            @default(true)
  shopId          String?
  productId       String?
  product         ProductLead?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  terms           String?
  lastValidatedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active, startsAt, endsAt])
  @@index([shopId])
  @@index([productId])
}

model CommercialPipelineRun {
  id                    String                         @id @default(cuid())
  mode                  CommercialPipelineRunMode
  status                CommercialPipelineRunStatus
  productId             String?
  product               ProductLead?                   @relation(fields: [productId], references: [id], onDelete: SetNull)
  groupDestinationId    String?
  groupDestination      WhatsAppDestination?           @relation(fields: [groupDestinationId], references: [id], onDelete: SetNull)
  productName           String?
  productPrice          Decimal?                       @db.Decimal(14, 4)
  groupName             String?
  groupFingerprint      String?
  score                 Int?
  candidateCount        Int                            @default(0)
  eligibleCount         Int                            @default(0)
  rejectedCount         Int                            @default(0)
  rejectionSummary      Json
  selectionReasons      Json
  copyPreview           String?
  plannedSubIds         Json
  dispatchId            String?                        @unique
  dispatch              WhatsAppDispatch?              @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  jobId                 String?                        @unique
  confirmedAt           DateTime?
  finalStatus           CommercialPipelineFinalStatus?
  investigationRequired Boolean                        @default(false)
  failureCode           String?
  createdAt             DateTime                       @default(now())
  completedAt           DateTime?
  dispatchOutbox        CommercialDispatchOutbox?

  @@index([createdAt])
  @@index([status, mode])
  @@index([productId])
  @@index([groupDestinationId])
  @@index([finalStatus])
  @@index([investigationRequired])
}

model CommercialDispatchOutbox {
  id              String                         @id @default(cuid())
  commercialRunId String                         @unique
  commercialRun   CommercialPipelineRun          @relation(fields: [commercialRunId], references: [id], onDelete: Restrict)
  dispatchId      String                         @unique
  dispatch        WhatsAppDispatch               @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  jobId           String                         @unique
  status          CommercialDispatchOutboxStatus @default(PENDING)
  failureCode     String?
  createdAt       DateTime                       @default(now())
  publishedAt     DateTime?

  @@index([status, createdAt])
}

model CommercialAutomationSettings {
  id        String    @id @default("commercial-automation")
  paused    Boolean   @default(true)
  pausedAt  DateTime? @default(now())
  resumedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt
}

model CommercialAutomationExecution {
  id              String                              @id @default(cuid())
  schedulerJobId  String
  bullMqJobId     String?                             @unique
  activeKey       String?                             @unique
  ownerId         String?
  heartbeatAt     DateTime?
  leaseExpiresAt  DateTime?
  mode            CommercialAutomationExecutionMode
  status          CommercialAutomationExecutionStatus
  reasons         Json
  commercialRunId String?
  failureCode     String?
  startedAt       DateTime                            @default(now())
  completedAt     DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([commercialRunId])
}

enum WhatsAppDispatchStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsAppDestinationType {
  INDIVIDUAL
  GROUP
}

enum ShopeeOfferSource {
  MOCK
  MANUAL
  OFFICIAL
}

enum CouponSource {
  MANUAL
  OFFICIAL
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CommercialPipelineRunMode {
  DRY_RUN
  CONFIRMED
}

enum CommercialPipelineRunStatus {
  STARTED
  COMPLETED
  BLOCKED
  FAILED
}

enum CommercialPipelineFinalStatus {
  PENDING
  SENT
  FAILED
  AMBIGUOUS
}

enum CommercialDispatchOutboxStatus {
  PENDING
  PUBLISHED
  AMBIGUOUS
}

enum CommercialAutomationExecutionMode {
  PREVIEW
  SEND
}

enum CommercialAutomationExecutionStatus {
  STARTED
  BLOCKED
  PREVIEW_READY
  QUEUED
  FAILED
  AMBIGUOUS
}
